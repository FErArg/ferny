<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows Installer package for Ferny (x64), built by scripts/package-msi.ps1
     with WiX Toolset v3.14. The application and Qt runtime files are harvested
     by heat.exe into the QtFiles component group. The package has no custom
     actions, no network access and no registry writes beyond the Start menu
     shortcut marker. UpgradeCode is fixed: do not change it. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Ferny" Language="1033" Version="$(var.Version)"
           Manufacturer="FErArg" UpgradeCode="{366A2BFF-A08F-4524-B2A8-359F51675B36}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Platform="x64" Description="Ferny $(var.Version)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Ferny is already installed. Uninstall it first." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="FernyIcon.ico" SourceFile="$(var.ProjectDir)\packaging\windows\ferny.ico" />
    <Property Id="ARPPRODUCTICON" Value="FernyIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://www.ferarg.com" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <!-- License dialog text: GPL-2.0-or-later, generated by scripts/package-msi.ps1
         from LICENSE (replaces the WiX sample text). -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <UIRef Id="WixUI_InstallDir" />

    <Feature Id="Complete" Title="Ferny" Level="1" ConfigurableDirectory="INSTALLFOLDER">
      <ComponentGroupRef Id="QtFiles" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Ferny" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Ferny" />
      </Directory>
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="{AC4955A5-FA37-459A-A21E-E08C840747AB}" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="Ferny"
                  Description="Geany-inspired programmer's editor"
                  Target="[INSTALLFOLDER]ferny.exe" WorkingDirectory="INSTALLFOLDER"
                  Icon="FernyIcon.ico" IconIndex="0" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\FErArg\Ferny" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
